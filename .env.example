# ─── Required ──────────────────────────────────────────────────────────
# Google Gemini API key — powers the Live voice session AND the kitchen's
# HTML-fragment fallback generator. Never exposed to the browser; the
# browser gets a short-lived ephemeral token from /session instead.
GEMINI_API_KEY=AIza...

# ─── Gemini tuning (all optional) ──────────────────────────────────────
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Prebuilt voice. Leda (warm, youthful) is the Momo default — sounds more
# natural on both Mandarin and English than Aoede. Other good bilingual
# picks: Kore (firm+warm), Puck (upbeat), Zephyr (bright), Charon (calm).
GEMINI_VOICE=Leda
GEMINI_LANGUAGE=cmn-CN
# Model used by the chart-HTML fallback generator (kitchen/generator.js).
VIZ_GEN_MODEL=gemini-3.1-flash-lite-preview

# ─── Database (optional — data tools degrade gracefully if unset) ─────
# Neon serverless Postgres connection URL. Without this, the data tools
# cannot return real data and charts will have nothing to render.
# NEON_DB_DATABASE=postgres://user:pass@ep-xxxx.neon.tech/omo?sslmode=require

# ─── Server ────────────────────────────────────────────────────────────
PORT=8080
# Interface to bind. Default 127.0.0.1 (this machine only). The server exposes
# agent terminals and business data, so only use 0.0.0.0 on a trusted network.
# HOST=127.0.0.1
# Set NO_OPEN=1 to suppress the auto-open browser on boot (CI / headless).
# NO_OPEN=1

# ─── Stripe (optional — read-only dashboard ingest) ───────────────────
# Restricted key: read-only on Charges/Customers/Subs/Balance/Products/
# Disputes/PaymentMethods/Payouts/Events. Use sk_test_* or rk_test_* during dev.
# Mint at https://dashboard.stripe.com/apikeys → "Create restricted key".
# STRIPE_SECRET_KEY=rk_test_...

# Set to 1 to override auto-detection and force-disable the Stripe mock.
# STRIPE_LIVE=1

# ─── Google OAuth (optional — Gmail / Drive / Docs / Calendar) ────────
# GCP project → APIs & Services → Credentials → OAuth 2.0 Client IDs
# of type "Web application". Authorized redirect URI must match
# GOOGLE_OAUTH_REDIRECT_URI below. Keep the consent screen in "Testing"
# mode and add your own Google account as a test user
# to skip Google's app-verification process.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback
# Refresh token, captured once after running through /auth/google/start.
# The callback will print it in the server log — paste it here, restart.
# GOOGLE_REFRESH_TOKEN=

# Force-disable Gmail mock when set; auto-disabled when REFRESH_TOKEN is present.
# GMAIL_LIVE=1
# Polling interval in ms for Gmail history (default 45000).
# GMAIL_POLL_MS=45000

# ─── Browserbase (optional — powers the spawn_browser_agent tool) ────
# Creates a remote Chromium session that the Gemini agent drives with
# Playwright over CDP. The live debug URL mounts as an iframe on
# /agents-grid so the user can literally watch the browser work.
# Dashboard: https://www.browserbase.com/settings
# BROWSER_API_KEY=bb_live_...
# BROWSER_PROJECT_ID=
#
# Anti-bot toggles (see src/agents/browserbase.js). Defaults are tuned
# for Reddit / Twitter / Cloudflare-fronted sites. Set to "0" to disable.
# BROWSERBASE_ADVANCED_STEALTH=1    # Enterprise plan only — set to 1 to attempt (default off)
# BROWSERBASE_SOLVE_CAPTCHAS=1      # auto-solve reCAPTCHA / hCaptcha / Turnstile (default on)
# BROWSERBASE_REGION=us-west-2      # us-west-2 (default, Oregon) | us-east-1 (Virginia) | eu-central-1 (Frankfurt) | ap-southeast-1 (Singapore)
# BROWSERBASE_SESSION_TIMEOUT_SEC=900  # session auto-terminate (60–21600s, max 6h)
# Proxies — biggest unlock for Reddit / Twitter / Cloudflare-fronted sites.
# Three modes, resolved by src/agents/browserbase.js::resolveProxyMode():
#   (A) builtin  → BROWSERBASE_PROXIES=1 (or unset)   → Browserbase-managed rotating residential pool.
#                                                        Developer plan+. Billed by data (1 MB/session min).
#   (B) geo      → BROWSERBASE_PROXIES=geo + BROWSERBASE_PROXY_COUNTRY=US (+ optional _STATE / _CITY)
#                                                      → Browserbase managed, geo-targeted.
#   (C) external → BROWSERBASE_PROXIES=external + BROWSERBASE_PROXY_SERVER=http://host:port
#                                                 (+ optional _USERNAME / _PASSWORD / _DOMAIN_PATTERN)
#                                                      → bring-your-own (e.g. tunneled hotspot or 3rd-party provider).
#   (off)        → BROWSERBASE_PROXIES=0              → no proxies.
# Default = builtin ON. Runner auto-falls-back to no-proxies if the plan rejects it.
# BROWSERBASE_PROXIES=1
# BROWSERBASE_PROXY_COUNTRY=US
# BROWSERBASE_PROXY_STATE=
# BROWSERBASE_PROXY_CITY=
# BROWSERBASE_PROXY_SERVER=
# BROWSERBASE_PROXY_USERNAME=
# BROWSERBASE_PROXY_PASSWORD=
# BROWSERBASE_PROXY_DOMAIN_PATTERN=

# ─── Web search (optional — powers the web_search tool) ───────────────
# Tavily API key. Without this, web_search returns a clean "not configured"
# response so Momo can tell the user honestly. Free key at https://tavily.com.
# TAVILY_API_KEY=

# ─── GitHub (optional — read-mostly + PR review delegation) ──────────
# Personal Access Token (classic or fine-grained). Needs repo + read:user
# scopes for the configured repos; add admin:repo_hook + workflow if you
# also want webhook delivery + workflow run details.
# Mint at https://github.com/settings/tokens (classic) or
# https://github.com/settings/personal-access-tokens (fine-grained).
# GITHUB_TOKEN=ghp_...
#
# Comma-separated allowlist of "owner/repo" the connector will follow.
# Anything outside this list is invisible to omo even if the token has
# broader scope — keeps the blast radius scoped to what you opted in.
# GITHUB_REPOS=acme/storefront,acme/docs
#
# Polling cadence in ms (default 60000 = 1 min). Lower = fresher cards
# at the cost of API quota. Github classic PAT budget is 5000/hour.
# GITHUB_POLL_MS=60000
#
# Webhook secret for /omo/api/integrations/github/webhook. When set, omo
# verifies HMAC-SHA256 on every delivery and turns push/PR/CI events into
# hologram cards within ~1s. Setup: GitHub repo → Settings → Webhooks →
# payload URL = https://<your-omo>/omo/api/integrations/github/webhook,
# content type = application/json, secret = this value, events = let me
# select (Pull requests, Pull request reviews, Workflow runs, Releases,
# Issues, Pushes). Without this var the webhook endpoint refuses traffic.
# GITHUB_WEBHOOK_SECRET=

# ─── Cyberdesk (optional · powers /agent's virtual desktop) ───────────
# Hosted Linux desktops for computer-use agents (click/type/screenshot).
# Sign up at https://cyberdesk.io.  Without it, /agent renders a setup
# banner and the launch endpoint returns 503.
# CYBERDESK_API_KEY=

# ─── Holo3 / /automation (optional · vision-driven computer-use agent) ─
# H Company's Holo3 VLM reads each screenshot and emits the next
# tool_call (click/write/scroll/press_keys/answer). The /automation page
# can drive two "bodies":
#   • your Mac (local) — via bin/holo3_mac.py + pyautogui. No extra env.
#   • a Browserbase Chromium (remote) — needs BROWSER_API_KEY/PROJECT_ID
#     in the Browserbase block above.
# Generate the H Company key at https://hub.hcompany.ai. The browser
# never talks to api.hcompany.ai directly; /omo/api/holo3/* proxies.
# HAI_API_KEY=hk_...
# Pick the variant — A3B is fast (3B active), 122B-A10B is higher-quality.
# HOLO3_MODEL=holo3-35b-a3b
